*.md text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.pdf binary
*.xlsx binary
*.docx binary
*.xml -text

# Preserve original document bytes; do not normalize line endings.
documentation/**/*.3dm -text
documentation/**/*.DWG -text
documentation/**/*.pdf -text
documentation/**/*.jpg -text
documentation/99-service/email-reaction.json -text whitespace=cr-at-eol

# Preserve exact released analysis bytes, including converter CRLF streams.
deliverables/G01/** -text whitespace=cr-at-eol
# Generator formatting is preserved verbatim; review authored Markdown/scripts normally.
deliverables/G01/**/*.svg -whitespace linguist-generated=true
deliverables/G01/**/*.dxf -whitespace linguist-generated=true
deliverables/G01/**/*.log -whitespace linguist-generated=true
deliverables/G01/**/lines-decoded.json -whitespace linguist-generated=true

# G02 release: retain exact reviewed converter and generated bytes.
deliverables/G02/** -text whitespace=cr-at-eol
deliverables/G02/**/*.svg -whitespace linguist-generated=true
deliverables/G02/**/*.dxf -whitespace linguist-generated=true
deliverables/G02/**/*.log -whitespace linguist-generated=true

# T01 tooling and visual reference release.
*.blend binary
*.FCStd binary
deliverables/T01/** -text whitespace=cr-at-eol
deliverables/T01/**/*.log -whitespace linguist-generated=true

# Experimental releases preserve exact checked bytes.
experiments/** -text whitespace=cr-at-eol
experiments/**/*.log -whitespace linguist-generated=true
*.gz binary

# M02: preserve exact reviewed supplier registers and generated workbook bytes.
deliverables/M02/** -text whitespace=cr-at-eol
deliverables/M03/** -text whitespace=cr-at-eol
deliverables/M04/** -text whitespace=cr-at-eol
deliverables/M05/** -text whitespace=cr-at-eol
deliverables/M06/** -text whitespace=cr-at-eol

# Preserve upstream font licence formatting verbatim.
experiments/**/font-license.txt -whitespace

# G03 approximate geometry study: preserve reviewed mesh/plot/calculation bytes.
deliverables/G03/** -text whitespace=cr-at-eol
deliverables/G03/**/*.svg -whitespace linguist-generated=true
